{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeDevCommand": "pnpm turbo run dev --filter=@modrinth/app-frontend",
		"beforeBuildCommand": "pnpm turbo run build --filter=@modrinth/app-frontend",
		"frontendDist": "../app-frontend/dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"category": "Game",
		"copyright": "Copyright © 2026 LuniVex",
		"targets": "all",
		"externalBin": [],
		"icon": ["icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerHooks": "./nsis/hooks.nsi"
			}
		},
		"longDescription": "",
		"macOS": {
			"entitlements": "App.entitlements",
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null,
			"dmg": {
				"background": "./dmg/dmg-background.png",
				"windowSize": {
					"width": 661,
					"height": 432
				},
				"appPosition": {
					"x": 188,
					"y": 212
				},
				"applicationFolderPosition": {
					"x": 475,
					"y": 212
				}
			}
		},
		"shortDescription": "",
		"linux": {
			"deb": {
				"depends": []
			}
		},
		"fileAssociations": [
			{
				"ext": ["mrpack"],
				"name": "LuniVex Modpack",
				"description": "Minecraft Modpack",
				"mimeType": "application/x-modrinth-modpack+zip",
				"role": "Editor"
			}
		]
	},
	"productName": "LuniVex",
	"version": "../app-frontend/package.json",
	"mainBinaryName": "LuniVex",
	"identifier": "xyz.lunivex.app",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["modrinth"]
			},
			"mobile": []
		},
		"updater": {
			"endpoints": [
				"https://github.com/LuniVex/lunivex/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMjlEMEZDODExNTcwQjgKUldTNGNCV0IvTkFwdjhqWHJ3RkRYT3dGYmdTeFE1TndqU3ZaazlLQ3ZIcTlIMTFnZVQrVGNIRzgK"
		}
	},
	"app": {
		"withGlobalTauri": false,
		"macOSPrivateApi": true,
		"windows": [
			{
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"fullscreen": false,
				"height": 800,
				"resizable": true,
				"title": "LuniVex",
				"label": "main",
				"width": 1280,
				"minHeight": 700,
				"minWidth": 1100,
				"visible": false,
				"zoomHotkeysEnabled": false,
				"decorations": false
			}
		],
		"security": {
			"assetProtocol": {
				"scope": [
					"$APPDATA/caches/icons/*",
					"$APPCONFIG/caches/icons/*",
					"$CONFIG/caches/icons/*",
					"$APPDATA/profiles/*/saves/*/icon.png",
					"$APPCONFIG/profiles/*/saves/*/icon.png",
					"$CONFIG/profiles/*/saves/*/icon.png"
				],
				"enable": true
			},
			"capabilities": ["core", "plugins", "updater"],
			"csp": {
				"default-src": "'self' customprotocol: asset:",
				"connect-src": "ipc: http://ipc.localhost https://modrinth.com https://*.modrinth.com https://*.nodes.modrinth.com wss://*.nodes.modrinth.com https://api.mclo.gs http://textures.minecraft.net https://textures.minecraft.net https://fill.papermc.io https://api.purpurmc.org https://downloads.essential.gg 'self' data: blob:",
				"font-src": ["https://cdn-raw.modrinth.com/fonts/"],
				"img-src": "https: 'unsafe-inline' 'self' asset: http://asset.localhost http://textures.minecraft.net https://media.forgecdn.net https://cdn.curseforge.com blob: data:",
				"style-src": "'unsafe-inline' 'self'",
				"script-src": "'self'",
				"frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://discord.com 'self'",
				"media-src": "https://*.githubusercontent.com"
			}
		}
	}
}
